# Copy this file to .env and fill in real values. .env is git-ignored.

# qBittorrent WebUI
QB_HOST=qbittorrent
QB_PORT=8080
# Leave both empty to rely on qBittorrent's IP-whitelist auth bypass instead.
QB_USER=
QB_PASS=

# Sonarr
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=

# Category Sonarr assigns to TV downloads in qBittorrent
QB_CATEGORY=tv-sonarr

# Optional shared secret for POST /api/skip (?token=... or X-API-Token header).
# Recommended if the port is reachable from outside the Docker network.
API_TOKEN=

LOG_LEVEL=INFO
PORT=8088
